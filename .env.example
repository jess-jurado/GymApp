# Clave secreta para sesiones y firmado de tokens (Flask & JWT)
SECRET_KEY=cambia_esta_clave_por_una_segura_y_aleatoria

# Integración con IA: NVIDIA NIM API (Llama 3.3 70B Instruct)
# Obtén tu clave en: https://build.nvidia.com/
NVIDIA_API_KEY=tu_nvidia_api_key_aqui

# Configuración de Correo Electrónico (Opcional - SMTP para confirmación de cuentas)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_o_token_de_aplicacion

# Cloudinary (Opcional - Almacenamiento y subida de imágenes en la nube)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Base de datos (Opcional - Por defecto usa SQLite gymapp.db localmente)
# DB_HOST=localhost
# DB_NAME=gymapp
# DB_USER=postgres
# DB_PASSWORD=password
# DB_PORT=5432
